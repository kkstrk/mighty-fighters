{
	"name": "mighty-fighters",
	"version": "0.0.0",
	"private": "true",
	"description": "",
	"license": "MIT",
	"author": "Kasia Kosturek",
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"lint": "vp fmt --check && vp lint --deny-warnings && stylelint \"**/*.css\" && knip",
		"format": "vp check --fix && stylelint \"**/*.css\" --fix",
		"test": "vp test run",
		"prepare": "vp config",
		"typecheck": "tsc --noEmit",
		"verify": "pnpm lint && gitleaks git --redact --no-banner && pnpm audit --prod --audit-level high && pnpm typecheck && pnpm test && pnpm test:e2e",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@fontsource/pixelify-sans": "5.3.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@playwright/test": "1.64.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"jsdom": "^27.4.0",
		"knip": "6.43.0",
		"stylelint": "17.16.0",
		"stylelint-config-css-modules": "4.6.0",
		"stylelint-config-recess-order": "7.9.0",
		"stylelint-config-standard": "40.0.0",
		"stylelint-declaration-strict-value": "1.12.1",
		"stylelint-high-performance-animation": "2.0.0",
		"stylelint-order": "8.1.2",
		"stylelint-plugin-defensive-css": "2.9.7",
		"stylelint-plugin-logical-css": "2.1.0",
		"stylelint-plugin-use-baseline": "1.4.8",
		"stylelint-value-no-unknown-custom-properties": "6.1.1",
		"typescript": "7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vite-plus": "1.4.0"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@11.22.0"
}
